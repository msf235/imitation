{'code': '# Creating a demonstration Jupyter notebook for BCOfromObservation usage\nimport nbformat as nbf\n\nnb = nbf.v4.new_notebook()\nnb[\'cells\'
  ] = [\n    nbf.v4.new_markdown_cell("# Demonstration of BCOfromObservation (BCO)\\n"   \n                            "This notebook shows how to use the `BCOfromObservation` class to perform behavioral cloning from observation-only expert trajectories,\\n"  \n                            "with a separate set of random rollouts for training the inverse dynamics model (IDM)."),\n    nbf.v4.new_code_cell("""\n# Install required libraries (if not already installed)\n# !pip install imitation stable-baselines3 gymnasium\n"""),\n    nbf.v4.new_code_cell("""\nimport numpy as np\nimport gymnasium as gym\nfrom imitation.policies.serialize import load_policy\nfrom imitation.util.util import make_vec_env\nfrom imitation.data.wrappers import RolloutInfoWrapper\nfrom imitation.data import rollout as rollout_module\nfrom utils import args\nfrom bco import BCOfromObservation, generate_random_demonstrations\n\n# 1. Create an expert environment and load the policy\nrng = np.random.default_rng(0)\nexpert_env = make_vec_env(\n    "seals:seals/CartPole-v0",\n    rng=rng,\n    post_wrappers=[lambda env, _: RolloutInfoWrapper(env)],\n)\nexpert_policy = load_policy(\n    "ppo-huggingface",\n    organization="HumanCompatibleAI",\n    env_name="seals:seals/CartPole-v0",\n    venv=expert_env,\n)\nprint("Expert policy loaded and ready.")\n"""),\n    nbf.v4.new_code_cell("""\n# 2. Generate expert demonstration transitions (observation-only)\nrollouts_expert = rollout_module.rollout(\n    expert_policy,\n    expert_env,\n    rollout_module.make_sample_until(min_episodes=50, min_timesteps=None),\n    rng=rng,\n)\nexpert_transitions = rollout_module.flatten_trajectories(rollouts_expert)\nprint(f"Collected {len(expert_transitions.observations)
    } expert transitions.")\n"""),\n    nbf.v4.new_code_cell("""\n# 3. Generate random IDM demonstration transitions\nidm_transitions = generate_random_demonstrations(\n    env=expert_env,\n    num_episodes=50,\n    rng=rng,\n)\nprint(f"Collected {len(idm_transitions.observations)
    } random IDM transitions.")\n"""),\n    nbf.v4.new_code_cell("""\n# 4. Instantiate BCOfromObservation\nfrom gymnasium.spaces import Box, Discrete\n\nenv = expert_env.envs[0].unwrapped\nobservation_space = env.observation_space\naction_space = env.action_space\n\nbco = BCOfromObservation(\n    observation_space=observation_space,\n    action_space=action_space,\n    rng=rng,\n    demonstrations=expert_transitions,\n    idm_demonstrations=idm_transitions,\n    continuous=False\n)\nprint("BCO agent instantiated.")\n"""),\n    nbf.v4.new_code_cell("""\n# 5. Train BCO for a small number of episodes\nbco.max_episodes = 100\nbco.batch_size   = 32\nbco.M            = 200\n\nbco.train(log_interval=10)\n"""),\n    nbf.v4.new_code_cell("""\n# 6. Evaluate the trained policy\nfrom stable_baselines3.common.evaluation import evaluate_policy\n\ndef policy_fn(obs):\n    # obs: [B, state_dim]\n    actions = bco.policy_net(torch.tensor(obs, dtype=torch.float32))\n    return actions.detach().numpy(), None\n\n# Wrap policy_fn in a gym-compatible class\nclass TorchPolicyWrapper:\n    def __init__(self, policy_fn):\n        self.policy_fn = policy_fn\n    def predict(self, obs, state=None, mask=None):\n        return self.policy_fn(obs)\n\neval_env = gym.make("CartPole-v0")\nreward, std = evaluate_policy(\n    TorchPolicyWrapper(policy_fn),\n    eval_env,\n    n_eval_episodes=10\n)\nprint(f"Average evaluation reward over 10 episodes: {reward
    } ± {std
    }")\n"""),\n
